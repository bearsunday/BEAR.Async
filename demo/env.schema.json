{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "DB_DSN": {
            "type": "string",
            "description": "Database DSN (sqlite:path or mysql:host=...;dbname=...)"
        },
        "DB_USER": {
            "type": "string",
            "description": "Database username"
        },
        "DB_PASS": {
            "type": "string",
            "description": "Database password"
        }
    },
    "required": ["DB_DSN"],
    "additionalProperties": true
}
