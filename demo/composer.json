{
    "name": "bear/async-demo",
    "type": "project",
    "license": "proprietary",
    "description": "Demo application for BEAR.Async with ext-parallel and ext-swoole support",
    "repositories": [
        {
            "type": "path",
            "url": "../"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "koriym/env-json": "^1.0",
        "bear/async": "1.x-dev",
        "bear/resource": "dev-pure-singleton-resource",
        "bear/package": "^1.14",
        "bear/sunday": "^1.6",
        "ray/aop": "^2.12",
        "ray/aura-sql-module": "^1.13",
        "ray/di": "^2.14",
        "ray/media-query": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "bear/devtools": "^1.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\AsyncDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\AsyncDemo\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@setup",
            "@composer bin all install --ansi"
        ],
        "setup": "php bin/setup.php",
        "compile": "./vendor/bin/bear.compile 'BEAR\\AsyncDemo' prod-app ./",
        "parallel-benchmark": "php bin/parallel-benchmark.php",
        "swoole-benchmark": "php bin/swoole-benchmark.php",
        "test": "./vendor/bin/phpunit",
        "coverage": "php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage",
        "pcov": "php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage  --coverage-clover=coverage.xml",
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf src tests",
        "metrics": "./vendor/bin/phpmetrics --report-html=build/metrics --exclude=Exception src",
        "clean": [
            "./vendor/bin/phpstan clear-result-cache",
            "./vendor/bin/psalm --clear-cache",
            "rm -rf ./var/tmp/*.php"
        ],
        "sa": [
            "./vendor/bin/psalm --show-info=true",
            "./vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "phpmd": "php -d error_reporting=22527 ./vendor/bin/phpmd src text ./phpmd.xml",
        "tests": [
            "@cs",
            "@sa",
            "@phpmd",
            "@test"
        ],
        "build": [
            "@clean",
            "@cs",
            "@sa",
            "@pcov",
            "@compile",
            "@metrics"
        ],
        "serve": "COMPOSER_PROCESS_TIMEOUT=0 php -dzend_extension=xdebug.so -S 127.0.0.1:8080 -t public",
        "app": "php bin/app.php",
        "page": "php bin/page.php",
        "xprofile": "./vendor/bin/xprofile -- php bin/app.php get 'app://self/dashboard?user_id=1'",
        "xprofile-parallel": "APP_CONTEXT=cli-parallel-hal-api-app ./vendor/bin/xprofile -- php bin/app.php get 'app://self/dashboard?user_id=1'",
        "xprofile-swoole": "APP_CONTEXT=cli-swoole-hal-api-app ./vendor/bin/xprofile -- php bin/app.php get 'app://self/dashboard?user_id=1'"
    },
    "scripts-descriptions": {
        "setup": "Initialize database and clear cache",
        "compile": "Compile DI scripts for production",
        "parallel-benchmark": "Run ext-parallel benchmark (8 SQL embeds)",
        "swoole-benchmark": "Run ext-swoole benchmark (8 SQL embeds)",
        "test": "Run unit tests",
        "tests": "Run tests and quality checks",
        "coverage": "Generate test coverage report",
        "pcov": "Generate test coverage report (pcov)",
        "cs": "Check coding standards",
        "cs-fix": "Fix coding standards",
        "sa": "Run static analysis",
        "phpmd": "Detect code quality issues",
        "metrics": "Build metrics report",
        "clean": "Clear cache files",
        "serve": "Start built-in server",
        "app": "Request app resource",
        "page": "Request page resource",
        "xprofile": "Profile dashboard (sync) with Xdebug",
        "xprofile-parallel": "Profile dashboard (parallel) with Xdebug",
        "xprofile-swoole": "Profile dashboard (swoole) with Xdebug"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    }
}
