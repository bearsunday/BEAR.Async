{
    "name": "bear/async",
    "description": "Async/parallel resource execution library for BEAR.Sunday",
    "keywords": ["async", "parallel", "crawl", "swoole", "amp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "bear/resource": "^1.17",
        "ray/di": "^2.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "bamarni/composer-bin-plugin": "^1.4",
        "amphp/amp": "^3.1"
    },
    "suggest": {
        "ext-swoole": "For Swoole coroutine support",
        "amphp/amp": "For Amp async support"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\Async\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\Async\\": "tests/",
            "BEAR\\Async\\Demo\\": "demo/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "tests": ["@cs", "@test", "@sa"],
        "cs": "phpcs --standard=phpcs.xml src tests",
        "cs-fix": "phpcbf src tests",
        "sa": ["psalm --no-progress", "phpstan analyse -c phpstan.neon --no-progress"],
        "metrics": "phpmetrics --report-html=build/metrics src"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true,
            "target-directory": "vendor-bin"
        }
    }
}
